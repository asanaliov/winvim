<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Winvim</RootNamespace>
    <AssemblyName>winvim</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <!-- WPF's text/font layout needs real culture data (MS.Internal.FontCache), so
         InvariantGlobalization can't be enabled here — it crashes the first time any
         text renders (e.g. TypeInitializationException in MajorLanguages..cctor). -->
    <!-- DPI-unaware is set deliberately in app.manifest; see the comment there. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
